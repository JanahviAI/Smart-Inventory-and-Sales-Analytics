# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inventory_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Set to 'sqlite' for offline local testing / CI if PostgreSQL is not running
DB_TYPE=postgresql
SQLITE_DB_PATH=data/local_inventory.db

# Storage Directories
DATA_SOURCE_DIR=data/source
DATA_LANDING_DIR=data/landing
DATA_PROCESSED_DIR=data/processed
REPORTS_DIR=results

# Pipeline Settings
LOG_LEVEL=INFO

# Streaming (Redpanda)
REDPANDA_BOOTSTRAP_SERVERS=localhost:9092
REDPANDA_TOPIC=sales.events
REDPANDA_CONSUMER_GROUP=smart-inventory-consumer
REDPANDA_AUTO_OFFSET_RESET=earliest

